# llama-server pin for CI/tests (Dependabot). Single-stage: one FROM, optional --flags before the image.
# Rolling `server` can move; llama.cpp also tags by short commit SHA—those tags avoid mutability (like a digest). We use `server` for bumps; use a SHA tag or @sha256 to pin.
FROM ghcr.io/ggml-org/llama.cpp:server
