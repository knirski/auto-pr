# direnv: load the Nix dev shell when this repo's flake supports the host.
# Intel macOS: skipped — the flake has no x86_64-darwin; use Homebrew etc. (CONTRIBUTING.md).
# Optional: nix-direnv (https://github.com/nix-community/nix-direnv) for cached reloads.
case "$(uname -s)-$(uname -m)" in
Linux-x86_64 | Linux-aarch64 | Darwin-arm64)
	use flake
	;;
esac
