# Copy to .env for local runs (never commit .env). Authoritative table: src/auto-pr/config.ts
#
# --- GitHub Actions / pipeline (get-commits, generate-content, create-or-update-pr) ---
# GITHUB_WORKSPACE=/path/to/repo
# GITHUB_OUTPUT=/path/to/step/output
# DEFAULT_BRANCH=main
# BRANCH=ai/my-feature

# --- gh + PR operations (create-or-update-pr, run-auto-pr; github-models needs this) ---
# GH_TOKEN=

# --- Cursor: GitHub MCP (remote). Export in your shell or OS env — .cursor/mcp.json interpolates this var.
# See https://github.com/github/github-mcp-server/blob/main/docs/installation-guides/install-cursor.md
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- AI provider: local | github-models (default: local). "local" = OpenAI-compatible HTTP (e.g. llama.cpp). ---
# AUTO_PR_AI_PROVIDER=local
# AUTO_PR_AI_OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1
# AUTO_PR_AI_OPENAI_COMPAT_API_KEY=
# AUTO_PR_AI_OPENAI_COMPAT_MODEL=gpt-oss
# (same var for github-models; default microsoft/phi-4-mini-instruct when unset for that provider)

# --- Local act (`bun run act`) — optional; see CONTRIBUTING.md ---
# Omit ACT_RUNS_ON_LABEL to use the script default (aligned with this repo’s workflow `runs-on`). Set it only when simulating jobs whose label differs.
# Omit ACT_RUNNER_IMAGE to use the script defaults (see resolveActRunnerImage in src/core/act-local-ci.ts). Set it only to pin or swap the container image for `act -P`.

# --- Optional ---
# NO_COLOR=1
# AUTO_PR_DEBUG=1
