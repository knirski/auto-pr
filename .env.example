# Copy to .env for local runs (never commit .env). Authoritative table: src/auto-pr/config.ts
#
# Convention: put durable defaults here (tokens, AUTO_PR_*, optional act overrides). For one-off
# experiments, use the shell instead, e.g. ACT_RUNNER_IMAGE=... bun run act -- check.
#
# --- GitHub Actions / pipeline (generate-content, create-or-update-pr, auto-pr-run) ---
# GITHUB_WORKSPACE=/path/to/repo
# GITHUB_OUTPUT=/path/to/step/output
# DEFAULT_BRANCH=main
# BRANCH=ai/my-feature

# --- gh + PR operations (create-or-update-pr, run-auto-pr; existing PR title lookup) ---
# GH_TOKEN=

# --- Cursor: GitHub MCP (remote). Export in your shell or OS env — .cursor/mcp.json interpolates this var.
# See https://github.com/github/github-mcp-server/blob/main/docs/installation-guides/install-cursor.md
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- AI provider: openrouter | local (config default: local; stock workflows default to openrouter) ---
# "openrouter" = OpenRouter cloud free models; "local" = OpenAI-compatible HTTP (e.g. llama.cpp).
# AUTO_PR_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# AUTO_PR_OPENROUTER_MODEL=openai/gpt-oss-20b:free   # free id: vendor/model:free (or openrouter/free)
# AUTO_PR_OPENROUTER_HTTP_REFERER=
# AUTO_PR_OPENROUTER_TITLE=auto-pr
# local only:
# AUTO_PR_AI_OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1
# AUTO_PR_AI_OPENAI_COMPAT_API_KEY=
# AUTO_PR_LOCAL_MODEL=gpt-oss

# --- Local act (`bun run act`) — optional; see CONTRIBUTING.md ---
# Omit ACT_RUNS_ON_LABEL to use the script default (aligned with this repo’s workflow `runs-on`). Set it only when simulating jobs whose label differs.
# Omit ACT_RUNNER_IMAGE to use the script defaults (see resolveActRunnerImage in scripts/act-local-ci.ts). Set it only to pin or swap the container image for `act -P`.
# Do not set GITHUB_ACTIONS in .env unless you intentionally want to mimic GitHub Actions runner
# behavior (e.g. smaller default image for dry-run); leave it unset for normal local `act` runs.

# --- Integration tests (`bun run test:integration`) — loads `.env.ci` then optional `.env.local` (same pattern as Vite/Next: local overrides, gitignored) ---
# Put only overrides in `.env.local` (same `KEY`s as `.env.ci`); missing file is fine.
# INTEGRATION_LLAMA_PORT=8080         # llama Docker port (also in `.env.ci` for integration tests in CI)
# INTEGRATION_LLAMA_STUB_MODEL_URL=   # stub GGUF (local-fallback tests)
# INTEGRATION_LLAMA_MODEL_URL=        # full GGUF (local-happy tests; optional `--jinja` in workflow)
# INTEGRATION_OPENROUTER_MODEL=openai/gpt-oss-20b:free  # OpenRouter model id (test skips without OPENROUTER_API_KEY)

# --- Optional ---
# NO_COLOR=1
# AUTO_PR_DEBUG=1
