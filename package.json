{
  "name": "auto-pr",
  "version": "0.1.5",
  "description": "Auto-create PRs from conventional commits on ai/** branches",
  "keywords": [
    "auto-pr",
    "conventional-commits",
    "github",
    "github-actions",
    "pr-template",
    "ai-assisted-development",
    "pull-request"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knirski/auto-pr.git"
  },
  "homepage": "https://github.com/knirski/auto-pr#readme",
  "bugs": {
    "url": "https://github.com/knirski/auto-pr/issues"
  },
  "type": "module",
  "bin": {
    "auto-pr-generate-content": "./dist/workflow/auto-pr-generate-content.js",
    "auto-pr-build-model-routing-context": "./dist/workflow/auto-pr-build-model-routing-context.js",
    "auto-pr-create-or-update-pr": "./dist/workflow/auto-pr-create-or-update-pr.js",
    "auto-pr-run": "./dist/workflow/auto-pr-run.js",
    "auto-pr-fill-pr-template": "./dist/tools/auto-pr-fill-pr-template.js",
    "auto-pr-init": "./dist/tools/auto-pr-init.js"
  },
  "files": [
    "dist",
    ".github",
    "docs",
    ".nvmrc",
    ".bun-version"
  ],
  "scripts": {
    "test": "bun test",
    "test:integration": "bun --env-file=.env.ci --env-file=.env.local --config=bunfig.integration.toml test test/integration",
    "test:all": "bun test && bun run test:integration",
    "test:watch": "bun test --watch",
    "check": "bash scripts/check-nix-hash.sh && bun run check:nix && bun run check:code && bun run check:docs && bun run lint:workflows && bun run lint:scripts",
    "act": "bun scripts/act-local-ci.ts",
    "check:code": "bun run check:manifest && bun run build && bun audit --audit-level=high && bun run lint && bun run knip && bun run typecheck && bun run test",
    "check:manifest": "bun run scripts/check-package-manifest.ts",
    "check:patch-coverage": "bun run scripts/check-patch-coverage.ts",
    "check:with-links": "bun run check && bun run check:just-links",
    "check:nix": "scripts/nix-run-if-missing.sh --optional statix check . && scripts/nix-run-if-missing.sh --optional deadnix --exclude bun.nix .",
    "check:docs": "bun x rumdl check . && scripts/nix-run-if-missing.sh typos",
    "check:just-links": "scripts/nix-run-if-missing.sh lychee --timeout 30 --max-retries 10 --retry-wait-time 2 --no-progress --accept 200,429 .",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "lint:scripts": "find scripts .github/actions -name '*.sh' -print0 | xargs -0 -r scripts/nix-run-if-missing.sh shellcheck && scripts/nix-run-if-missing.sh shfmt -d scripts .github/actions && bash scripts/smoke-update-pins-check-only.sh",
    "format:scripts": "scripts/nix-run-if-missing.sh shfmt -w scripts .github/actions",
    "lint:workflows": "scripts/nix-run-if-missing.sh actionlint",
    "format": "biome format --write .",
    "knip": "knip",
    "typecheck": "tsgo --noEmit",
    "generate-content": "bun run src/workflow/auto-pr-generate-content.ts",
    "build-model-routing-context": "bun run src/workflow/auto-pr-build-model-routing-context.ts",
    "create-or-update-pr": "bun run src/workflow/auto-pr-create-or-update-pr.ts",
    "fill-pr-template": "bun run src/tools/auto-pr-fill-pr-template.ts",
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build || exit 0",
    "prepublishOnly": "bun run build",
    "run-auto-pr": "bun run src/workflow/auto-pr-run.ts"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0-beta.98",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "conventional-commits-parser": "7.1.0",
    "effect": "4.0.0-beta.98",
    "micromustache": "8.0.3",
    "octokit": "5.0.5",
    "remark": "15.0.1",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.3.14",
    "knip": "6.26.0",
    "lefthook": "2.1.10",
    "lint-staged": "17.0.8",
    "rumdl": "0.2.33",
    "testcontainers": "12.0.4",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun x biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "*.sh": [
      "scripts/nix-run-if-missing.sh shfmt -w"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "picomatch": "^4.0.4",
    "protobufjs": "^7.5.5"
  }
}
