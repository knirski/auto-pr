# Committed CI pins for `.github/workflows/integration.yml` and local `bun run test:integration`.
# Loaded into the job environment on GitHub Actions; not secrets.

# TCP port for the llama-server Docker integration jobs (integration-local-fallback + integration-local-happy).
INTEGRATION_LLAMA_PORT=8080

# Mozilla tiny stub (~27 KiB) — no tool-call support. integration-local-fallback + ai-providers.local-fallback.
INTEGRATION_LLAMA_STUB_MODEL_URL=https://huggingface.co/Mozilla/llama-test-model/resolve/main/tiny-llama.gguf

# Free OpenRouter model for the cloud integration job + ai-providers.openrouter (key comes from
# OPENROUTER_API_KEY in the environment; the test skips when it is not set).
INTEGRATION_OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Full GGUF with tool-call + `--jinja` support — integration-local-happy + ai-providers.local-happy.
INTEGRATION_LLAMA_MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3-1.7B-GGUF/resolve/main/Qwen_Qwen3-1.7B-Q4_K_M.gguf
